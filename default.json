{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shared DX Renovate preset. Consumers extend this from their own renovate.json.",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "devcontainer": {
    "enabled": true
  },
  "git-submodules": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchDepNames": [
        ".devcontainer/components/agents",
        ".devcontainer/components/tools"
      ],
      "versioning": "semver",
      "allowedVersions": "/^v(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)$/",
      "groupName": "Fixed component pins"
    },
    {
      "matchDepTypes": ["dx-component"],
      "pinDigests": true
    },
    {
      "matchDepTypes": ["github-taskfile"],
      "pinDigests": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Bump GitHub MCP server image pins in annotated launchers.",
      "managerFilePatterns": ["/(^|/)dx-mcp$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\nGITHUB_MCP_IMAGE=\"[^:\"]+:(?<currentValue>v\\d+\\.\\d+\\.\\d+)\""
      ]
    },
    {
      "customType": "regex",
      "description": "Bump annotated GitHub component tag/SHA pairs in install scripts.",
      "managerFilePatterns": ["/(^|/)install\\.sh$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>github-tags) depName=(?<depName>[^ ]+) packageName=(?<packageName>[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)\\n(?<versionPrefix>[A-Za-z0-9_]+_version=\")(?<currentValue>v(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*))(?<versionJoin>\"\\n[A-Za-z0-9_]+_commit=\")(?<currentDigest>[0-9a-f]{40})(?<pairSuffix>\")"
      ],
      "depTypeTemplate": "dx-component",
      "datasourceTemplate": "{{{datasource}}}",
      "packageNameTemplate": "{{{packageName}}}",
      "versioningTemplate": "semver",
      "autoReplaceStringTemplate": "{{{versionPrefix}}}{{{newValue}}}{{{versionJoin}}}{{{newDigest}}}{{{pairSuffix}}}"
    },
    {
      "customType": "regex",
      "description": "Update SHA-pinned GitHub Taskfile includes using their SemVer tag comments.",
      "managerFilePatterns": ["/(^|/)Taskfile\\.ya?ml$/"],
      "matchStrings": [
        "(?<urlPrefix>https://github\\.com/(?<depName>[A-Za-z0-9-]+/[A-Za-z0-9_.-]+)/raw/)(?<currentDigest>[0-9a-f]{40})(?<fileSuffix>/taskfiles/[^\\\"'\\s?#,}\\]]+\\.ya?ml)(?<tagPrefix>\\s+#\\s*)(?<currentValue>v?(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:[-+][0-9A-Za-z.+-]+)?)(?<trailer>[\\\"'\\s,}\\]]|$)"
      ],
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver",
      "depTypeTemplate": "github-taskfile",
      "autoReplaceStringTemplate": "{{{urlPrefix}}}{{{newDigest}}}{{{fileSuffix}}}{{{tagPrefix}}}{{{newValue}}}{{{trailer}}}"
    }
  ]
}
