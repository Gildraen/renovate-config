{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shared Gildraen DX Renovate preset. Consumers extend this from their own renovate.json.",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "devcontainer": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Bump DX and tools tags in HTTPS Remote Taskfile includes.",
      "managerFilePatterns": ["/(^|/)Taskfile\\.ya?ml$/"],
      "matchStrings": [
        "(?:^|[\"'\\s])https://github\\.com/(?<depName>Gildraen/dx(?:-tools)?)\\.git//[^\"'\\s?#,}\\]]+\\?ref=(?<currentValue>v?(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:[-+][0-9A-Za-z.+-]+)?)(?:[\"'\\s,}\\]]|$)",
        "(?:^|[\"'\\s])https://github\\.com/(?<depName>Gildraen/dx(?:-tools)?)/raw/(?<currentValue>v?(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:[-+][0-9A-Za-z.+-]+)?)/taskfiles/[^\"'\\s?#,}\\]]+\\.ya?ml(?:[\"'\\s,}\\]]|$)",
        "(?:^|[\"'\\s])https://raw\\.githubusercontent\\.com/(?<depName>Gildraen/dx(?:-tools)?)/(?<currentValue>v?(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:[-+][0-9A-Za-z.+-]+)?)/taskfiles/[^\"'\\s?#,}\\]]+\\.ya?ml(?:[\"'\\s,}\\]]|$)"
      ],
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Bump the GitHub MCP server image pinned in versioned dx-mcp launchers.",
      "managerFilePatterns": ["/(^|/)dx-mcp$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\nGITHUB_MCP_IMAGE=\"[^:\"]+:(?<currentValue>v\\d+\\.\\d+\\.\\d+)\""
      ]
    },
    {
      "customType": "regex",
      "description": "Bump SemVer component versions in DX Dev Container Feature options.",
      "managerFilePatterns": [
        "/(^|/)\\.devcontainer\\.json$/",
        "/(^|/)\\.devcontainer/(?:[^/]+/)?devcontainer\\.json$/"
      ],
      "matchStringsStrategy": "recursive",
      "matchStrings": [
        "\"ghcr\\.io/gildraen/dx/dx:[^\"]+\"\\s*:\\s*\\{[^{}]*\\}",
        "\"(?<component>agents|tools)Version\"\\s*:\\s*\"(?<currentValue>v?(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:[-+][0-9A-Za-z.+-]+)?)\""
      ],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "Gildraen/dx-{{{component}}}",
      "versioningTemplate": "semver"
    }
  ]
}